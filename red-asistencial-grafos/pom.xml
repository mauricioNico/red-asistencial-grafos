<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>ar.edu.universitas</groupId>

    <artifactId>
        red-asistencial-grafos
    </artifactId>

    <version>
        1.2.0
    </version>

    <packaging>
        jar
    </packaging>

    <properties>

        <maven.compiler.release>
            17
        </maven.compiler.release>

        <project.build.sourceEncoding>
            UTF-8
        </project.build.sourceEncoding>

        <junit.version>
            5.11.4
        </junit.version>

    </properties>


    <!-- ===================================================== -->
    <!-- DEPENDENCIAS                                          -->
    <!-- ===================================================== -->

    <dependencies>

        <!-- JUnit 5 para las pruebas unitarias -->

        <dependency>

            <groupId>
                org.junit.jupiter
            </groupId>

            <artifactId>
                junit-jupiter
            </artifactId>

            <version>
                ${junit.version}
            </version>

            <scope>
                test
            </scope>

        </dependency>

    </dependencies>


    <!-- ===================================================== -->
    <!-- CONFIGURACIÓN DE BUILD                                -->
    <!-- ===================================================== -->

    <build>

        <!--
            Nombre del JAR generado.

            target/
            red-asistencial-grafos-dijkstra.jar
        -->

        <finalName>
            red-asistencial-grafos-dijkstra
        </finalName>


        <plugins>

            <!-- ================================================= -->
            <!-- COMPILADOR JAVA 17                                -->
            <!-- ================================================= -->

            <plugin>

                <groupId>
                    org.apache.maven.plugins
                </groupId>

                <artifactId>
                    maven-compiler-plugin
                </artifactId>

                <version>
                    3.13.0
                </version>

                <configuration>

                    <release>
                        17
                    </release>

                </configuration>

            </plugin>


            <!-- ================================================= -->
            <!-- EJECUCIÓN DE PRUEBAS JUNIT                        -->
            <!-- ================================================= -->

            <plugin>

                <groupId>
                    org.apache.maven.plugins
                </groupId>

                <artifactId>
                    maven-surefire-plugin
                </artifactId>

                <version>
                    3.5.2
                </version>

                <configuration>

                    <useModulePath>
                        false
                    </useModulePath>

                </configuration>

            </plugin>


            <!-- ================================================= -->
            <!-- GENERACIÓN DEL JAR EJECUTABLE                     -->
            <!-- ================================================= -->

            <plugin>

                <groupId>
                    org.apache.maven.plugins
                </groupId>

                <artifactId>
                    maven-jar-plugin
                </artifactId>

                <version>
                    3.4.2
                </version>

                <configuration>

                    <archive>

                        <manifest>

                            <mainClass>
                                ejercicioIntegrador.App
                            </mainClass>

                        </manifest>

                    </archive>

                </configuration>

            </plugin>

        </plugins>

    </build>

</project>